# ── Required: set in .env before first run ───────────────────────────────────
# These are read at startup and cannot be changed via the Settings UI.

# Bearer token for HTTP auth. Required if the server is network-accessible —
# without it anyone who can reach the host can trigger runs and read your data.
# Leave unset for localhost-only use.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVER_API_KEY=

# Interface and port (rarely need changing)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000


# ── Configurable in the Settings UI ──────────────────────────────────────────
# Open the gear icon in the web UI to change these at any time.
# A server restart is required for changes to take effect.
# Documented here for reference and headless/scripted deployments.

# --- LLM Provider ---

# Provider: ollama (default), openai, anthropic, fireworks
PROVIDER=ollama

# Primary model for synthesis (provider-specific name)
# ollama:     qwen3
# openai:     gpt-4.1
# anthropic:  claude-sonnet-4-6
# fireworks:  accounts/fireworks/models/llama-v3p3-70b-instruct
MODEL=qwen3

# Smaller model for Planner/Validator phases (optional — falls back to MODEL)
# ollama:     qwen3:1.7b
# openai:     gpt-4.1-mini
# anthropic:  claude-haiku-4-5-20251001
# fireworks:  accounts/fireworks/models/llama-v3p1-8b-instruct
# FAST_MODEL=

# Ollama base URL (only relevant when PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud LLM keys — only the key for the active PROVIDER is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=

# --- Search providers ---
# DuckDuckGo works out of the box — no key needed.
# Add any of the following to expand coverage (all have free tiers).

# Brave Search — 2,000 queries/month free
# Sign up at https://brave.com/search/api/
BRAVE_API_KEY=

# Jina — enables Jina Search as a parallel provider and higher Reader rate limits
# Get a free key at https://jina.ai/
JINA_API_KEY=

# SearXNG — self-hosted metasearch, no key or quota (JSON format must be enabled)
# e.g. http://127.0.0.1:8888
SEARXNG_URL=

# --- Personalization ---

# City/region injected into planner prompt for location-aware agents
# LOCATION=San Francisco, CA

# --- Advanced ---

# Context truncation profile: cloud | local | minimal
# cloud = no truncation (default); local = moderate; minimal = aggressive
# CONTEXT_BUDGET=cloud

# LLM sampling temperature (0 = deterministic, 1 = creative)
# TEMPERATURE=0.2

# LLM request timeout in seconds
# TIMEOUT=300


# ── Not in Settings UI (.env only) ───────────────────────────────────────────
# Path and behaviour settings — edit here only.

# Ollama Cloud search key (separate from the LLM provider key above)
# Get a key at https://ollama.com
# OLLAMA_API_KEY=

# Page fetch mode: "http" (raw fetch + Jina fallback) or "jina" (always use Jina Reader)
# WEB_FETCH_PROVIDER=http

# SQLite database path (default: ./search_history.db)
# DISPATCH_DB_PATH=./search_history.db

# Ollama keep-alive per request: 0 = unload after each call (default; frees RAM),
# -1 = keep loaded, 30m = duration, server = use the Ollama server's OLLAMA_KEEP_ALIVE
# KEEP_ALIVE=0

# Directory for YAML agent seed files (default: ./agents)
# DISPATCH_AGENTS_DIR=./agents

# Global default for planner_query_count (overridden per-agent in YAML or UI)
# PLANNER_QUERY_COUNT=5

# Max parallel workers for multi-track pipelines (0 = sequential)
# PARALLEL_SUB_PIPELINES=1

# Push notifications via ntfy (https://ntfy.sh) — delivered to the ntfy iOS app
# Install ntfy from the App Store, subscribe to your topic, then fill in below.
# Keep NTFY_TOPIC hard-to-guess on ntfy.sh (topics are public by default).
# Generate one: python -c "import secrets; print('dispatch-' + secrets.token_urlsafe(12))"
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=        # optional — for access-controlled private topics
# DISPATCH_URL=      # optional — tapping the notification opens this URL, e.g. http://192.168.1.100:8000
